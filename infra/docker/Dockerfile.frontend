# Dockerfile для frontend-сервиса SafeWorkHub
# Multi-stage сборка для оптимизации размера образа

# =============================================================================
# Базовый образ с Node.js
# =============================================================================
FROM node:20-alpine as base

# Устанавливаем pnpm глобально
RUN corepack enable && corepack prepare pnpm@latest --activate

# Рабочая директория
WORKDIR /app

# =============================================================================
# Образ для установки зависимостей
# =============================================================================
FROM base as deps

# Копируем файлы зависимостей
COPY frontend/package.json frontend/pnpm-lock.yaml* ./

# Устанавливаем зависимости
RUN pnpm install --frozen-lockfile

# =============================================================================
# Образ для разработки
# =============================================================================
FROM base as development

# Копируем зависимости
COPY --from=deps /app/node_modules ./node_modules

# Копируем исходный код
COPY frontend/ .

# Открываем порт для Vite dev server
EXPOSE 3000

# Переменные окружения для Vite
ENV HOST=0.0.0.0
ENV PORT=3000

# Команда запуска dev-сервера
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "3000"]

# =============================================================================
# Образ для сборки production
# =============================================================================
FROM base as builder

# Копируем зависимости
COPY --from=deps /app/node_modules ./node_modules

# Копируем исходный код
COPY frontend/ .

# Аргументы сборки для переменных окружения
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Собираем приложение
RUN pnpm build

# =============================================================================
# Production образ на базе nginx
# =============================================================================
FROM nginx:alpine as production

# Метаданные образа
LABEL maintainer="Yan Bubenok <yan@bubenok.com>"
LABEL description="SafeWorkHub Frontend"
LABEL version="1.0.0"

# Удаляем стандартную конфигурацию nginx
RUN rm -rf /usr/share/nginx/html/*

# Копируем собранное приложение
COPY --from=builder /app/dist /usr/share/nginx/html

# Копируем конфигурацию nginx
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Создаём непривилегированного пользователя для nginx
RUN chown -R nginx:nginx /usr/share/nginx/html \
    && chown -R nginx:nginx /var/cache/nginx \
    && chown -R nginx:nginx /var/log/nginx \
    && touch /var/run/nginx.pid \
    && chown -R nginx:nginx /var/run/nginx.pid

# Открываем порт
EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Запускаем nginx
CMD ["nginx", "-g", "daemon off;"]
