# SafeWorkHub - Шаблон переменных окружения
# Скопируйте этот файл в .env и заполните значения

# =============================================================================
# Общие настройки приложения
# =============================================================================

# Окружение: development, staging, production
APP_ENV=development

# Режим отладки (отключить в production!)
DEBUG=true

# Секретный ключ для подписи JWT токенов (ОБЯЗАТЕЛЬНО сменить в production!)
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-change-in-production

# =============================================================================
# База данных PostgreSQL
# =============================================================================

POSTGRES_USER=safeworkhub
POSTGRES_PASSWORD=safeworkhub_dev
POSTGRES_DB=safeworkhub
POSTGRES_PORT=5432

# URL подключения (формируется автоматически в docker-compose)
# DATABASE_URL=postgresql+asyncpg://safeworkhub:safeworkhub_dev@localhost:5432/safeworkhub

# =============================================================================
# Redis
# =============================================================================

REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Backend API
# =============================================================================

BACKEND_PORT=8000

# CORS origins (через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT настройки
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Frontend
# =============================================================================

FRONTEND_PORT=3000

# URL API для frontend (Vite)
VITE_API_URL=http://localhost:8000

# =============================================================================
# Email (SMTP)
# =============================================================================

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=noreply@safeworkhub.ru
# SMTP_FROM_NAME=SafeWorkHub

# =============================================================================
# Хранилище файлов (S3-совместимое)
# =============================================================================

# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=safeworkhub-files
# S3_REGION=ru-central1

# =============================================================================
# Мониторинг и логирование
# =============================================================================

# LOG_LEVEL=INFO
# SENTRY_DSN=https://your-sentry-dsn
